#!/bin/sh
# 앱 코드를 바꾸는 커밋에는 docs/progress.md 갱신을 같이 넣게 한다 (docs/README.md 참고).
# 건너뛰려면: git commit --no-verify

staged=$(git diff --cached --name-only --diff-filter=ACMRD)

echo "$staged" | grep -qE '^(lib/|android/|ios/|assets/|pubspec\.yaml$)' || exit 0
echo "$staged" | grep -qx 'docs/progress.md' && exit 0

cat >&2 <<'EOF'
pre-commit: 앱 코드가 바뀌었는데 docs/progress.md 가 스테이징되지 않았습니다.
docs/webview-plan.md 와 대조해 progress.md 의 상태 표, 다음에 할 일, 분석 기록을 갱신한 뒤 함께 커밋하세요.
분석이 필요 없는 커밋이면: git commit --no-verify
EOF
exit 1
